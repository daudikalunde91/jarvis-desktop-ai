{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS Desktop AI Assistant - Foundation, Brain, Agents, Memory and Security",
  "author": "JARVIS Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev": "node scripts/dev.cjs",
    "dev:frontend": "npm run dev --workspace=jarvis-frontend",
    "dev:backend": "npm run dev --workspace=jarvis-backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=jarvis-frontend",
    "build:backend": "npm run build --workspace=jarvis-backend",
    "start": "npm run start --workspace=jarvis-backend",
    "package": "pnpm build && pnpm exec electron-builder --config electron-builder.yml",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspace=jarvis-frontend && npm run typecheck --workspace=jarvis-backend",
    "test": "npx vitest run",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^4.2.0",
    "tsc-alias": "^1.8.10"
  },
  "workspaces": [
    "app/frontend",
    "app/backend"
  ]
}
